# Content-Security-Policy for the Snapmaker Flutter bundle (2.3.40), sent by WebPageServer on EVERY response.
# This is 'policy F' of docs/snapmaker-page-contract.md section 7g, verified in headless Chrome with zero violations, with ONE change:
# https://us.i.posthog.com is added to connect-src (ADR 0005 point 6, disclose-only: the page's analytics is not blocked).
# To block analytics again, remove that one token. The sha256 hashes are tied to bundle 2.3.40's inline content and must be
# regenerated on a bundle bump (docs/third-party/flutter_web.md). Lines starting with '#' are comments; the policy is the one
# remaining non-blank line. No 'unsafe-inline' and no 'unsafe-eval' may ever appear here (a test pins it).
default-src 'none'; script-src 'self' 'wasm-unsafe-eval' 'sha256-mEZyHyAWiUzjJfnCmCR5bQk51YnNF7m3c1Vzdo7P3TE='; style-src-elem 'self' 'sha256-Dw7J7C84cB3Pjxf0yMiH1Rv/LQtCNYdQXLJQ5438ruY=' 'sha256-6PzWCd8mtd/Smmh5C9K/JZgTivJys2gJB0q7BrFnYPo=' 'sha256-2hxujCU6WzSO6ycZznxFKlHE++BDsDuMYXT/O0zl8rM=' 'sha256-cgINIZw4iKgU7zccO2vPeZdQJIMlKEchLZG6hpkP+8k='; style-src-attr 'unsafe-hashes' 'sha256-0EZqoz+oBhx7gF4nvY2bSqoGyy4zLjNF+SDQXGp/ZrY='; style-src 'self'; img-src 'self' https://public.resource.snapmaker.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://id.snapmaker.com https://api.snapmaker.com https://public.resource.snapmaker.com https://fonts.gstatic.com https://us.i.posthog.com; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; script-src-attr 'unsafe-hashes' 'sha256-J5uhYQcnrxD9OoXgIg0Mem+oEBv4GehOXW4frM2+Cms='
