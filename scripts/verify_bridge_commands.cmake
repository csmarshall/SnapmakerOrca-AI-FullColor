# Gate for the Snapmaker page bridge command list (ADR 0005).
#   cmake -DBUNDLE_DIR=<resources/web/flutter_web> -DCOMMANDS=<resources/web/snapmaker_bridge_commands.txt> -P verify_bridge_commands.cmake
# Extracts every sw_<name> string from the bundle's main.*.js and requires each to appear in exactly one line of COMMANDS
# ("REGISTERED <name>" or "DENIED <name>"), and every listed name to exist in the bundle (no stale names). Fails on a name
# that is unclassified, listed twice, listed in both classes, or no longer in the bundle. The Catch2 test
# [SSWCP][device_ui] then requires the live registry to equal the REGISTERED lines.
cmake_minimum_required(VERSION 3.13)

if (NOT BUNDLE_DIR OR NOT COMMANDS)
    message(FATAL_ERROR "usage: cmake -DBUNDLE_DIR=... -DCOMMANDS=... -P verify_bridge_commands.cmake")
endif ()
if (NOT EXISTS "${COMMANDS}")
    message(FATAL_ERROR "command list not found: ${COMMANDS}")
endif ()
file(GLOB _mains "${BUNDLE_DIR}/main.*.js")
list(LENGTH _mains _n)
if (NOT _n EQUAL 1)
    message(FATAL_ERROR "expected exactly one main.*.js in ${BUNDLE_DIR}, found ${_n}")
endif ()

file(READ "${_mains}" _js)
string(REGEX MATCHALL "sw_[A-Za-z0-9_]+" _found "${_js}")
list(REMOVE_DUPLICATES _found)
list(LENGTH _found _found_n)
if (_found_n EQUAL 0)
    message(FATAL_ERROR "no sw_* names in the bundle: refusing to pass on an empty extraction")
endif ()

file(STRINGS "${COMMANDS}" _lines)
set(_problems 0)
set(_listed "")
foreach (_line IN LISTS _lines)
    if (_line MATCHES "^[ \t]*(#.*)?$")
        continue()
    endif ()
    if (NOT _line MATCHES "^(REGISTERED|DENIED) (sw_[A-Za-z0-9_]+)([ \t]+#.*)?$")
        message(SEND_ERROR "malformed line: ${_line}")
        math(EXPR _problems "${_problems}+1")
        continue()
    endif ()
    set(_class "${CMAKE_MATCH_1}")
    set(_name "${CMAKE_MATCH_2}")
    if (DEFINED _class_${_name})
        message(SEND_ERROR "listed more than once (${_class_${_name}} and ${_class}): ${_name}")
        math(EXPR _problems "${_problems}+1")
        continue()
    endif ()
    set(_class_${_name} "${_class}")
    list(APPEND _listed "${_name}")
endforeach ()

foreach (_name IN LISTS _found)
    if (NOT DEFINED _class_${_name})
        message(SEND_ERROR "unclassified bundle command: ${_name} (add REGISTERED or DENIED to ${COMMANDS})")
        math(EXPR _problems "${_problems}+1")
    endif ()
endforeach ()
foreach (_name IN LISTS _listed)
    list(FIND _found "${_name}" _idx)
    if (_idx EQUAL -1)
        message(SEND_ERROR "listed but not in the bundle: ${_name}")
        math(EXPR _problems "${_problems}+1")
    endif ()
endforeach ()

if (_problems GREATER 0)
    message(FATAL_ERROR "${_problems} problem(s) with the bridge command list")
endif ()
list(LENGTH _listed _listed_n)
message(STATUS "OK: ${_found_n} bundle commands, ${_listed_n} classified")
