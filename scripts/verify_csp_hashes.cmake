# Checks that the static inline <script>/<style> blocks of the vendored Snapmaker bundle's index.html are covered by the
# hashes in the page server's Content-Security-Policy, and that the script-src hash list holds nothing else.
#   cmake -DINDEX_HTML=<resources/web/flutter_web/index.html> -DCSP_FILE=<resources/web/flutter_web.csp> -P verify_csp_hashes.cmake
#
# What this CAN recompute: the SHA-256 (base64) of every inline <script> body and <style> body in index.html. It fails if
# index.html has an inline style="..." or on*="..." attribute (it cannot hash those statically; classify them by hand), if an
# inline block's hash is missing from script-src / style-src-elem, or if script-src carries a hash that no inline script has.
#
# What it CANNOT recompute, and the policy lists "verified in headless Chrome for bundle 2.3.40" (docs/snapmaker-page-contract.md
# 7g): the three further style-src-elem hashes (the Flutter overlay theme <style>, the flt-scene-host <style> and the <style>
# inside a shadow root, all created at runtime), style-src-attr (the overlay's parsed style="display:none;") and script-src-attr
# (the overlay's Reload onclick handler).
cmake_minimum_required(VERSION 3.13)

if (NOT INDEX_HTML OR NOT CSP_FILE)
    message(FATAL_ERROR "usage: cmake -DINDEX_HTML=... -DCSP_FILE=... -P verify_csp_hashes.cmake")
endif ()
foreach (_f IN ITEMS "${INDEX_HTML}" "${CSP_FILE}")
    if (NOT EXISTS "${_f}")
        message(FATAL_ERROR "not found: ${_f}")
    endif ()
endforeach ()

# --- hex digest -> base64 (CMake has no base64) ---
set(_b64 "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
function(hex_to_base64 hex out)
    string(LENGTH "${hex}" _len)
    set(_res "")
    set(_i 0)
    while (_i LESS _len)
        math(EXPR _rem "${_len}-${_i}")
        if (_rem GREATER 5)
            string(SUBSTRING "${hex}" ${_i} 6 _g)
            set(_pad 0)
        elseif (_rem EQUAL 4)
            string(SUBSTRING "${hex}" ${_i} 4 _g)
            set(_g "${_g}00")
            set(_pad 1)
        else ()
            string(SUBSTRING "${hex}" ${_i} 2 _g)
            set(_g "${_g}0000")
            set(_pad 2)
        endif ()
        math(EXPR _v "0x${_g}")
        math(EXPR _c0 "(${_v} >> 18) & 63")
        math(EXPR _c1 "(${_v} >> 12) & 63")
        math(EXPR _c2 "(${_v} >> 6) & 63")
        math(EXPR _c3 "${_v} & 63")
        string(SUBSTRING "${_b64}" ${_c0} 1 _s0)
        string(SUBSTRING "${_b64}" ${_c1} 1 _s1)
        string(SUBSTRING "${_b64}" ${_c2} 1 _s2)
        string(SUBSTRING "${_b64}" ${_c3} 1 _s3)
        if (_pad EQUAL 0)
            string(APPEND _res "${_s0}${_s1}${_s2}${_s3}")
        elseif (_pad EQUAL 1)
            string(APPEND _res "${_s0}${_s1}${_s2}=")
        else ()
            string(APPEND _res "${_s0}${_s1}==")
        endif ()
        math(EXPR _i "${_i}+6")
    endwhile ()
    set(${out} "${_res}" PARENT_SCOPE)
endfunction()

# Self-check against a known vector: SHA-256("abc") = ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0=
string(SHA256 _abc_hex "abc")
hex_to_base64("${_abc_hex}" _abc_b64)
if (NOT _abc_b64 STREQUAL "ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0=")
    message(FATAL_ERROR "internal error: base64 self-check failed (${_abc_b64})")
endif ()

# --- the policy ---
file(READ "${CSP_FILE}" _csp)
string(REGEX REPLACE "(^|\n)[ \t]*#[^\n]*" "" _csp "${_csp}")
string(REGEX MATCH "(^|[; \n])script-src ([^;]*)" _m "${_csp}")
set(_script_src "${CMAKE_MATCH_2}")
string(REGEX MATCH "style-src-elem ([^;]*)" _m "${_csp}")
set(_style_elem "${CMAKE_MATCH_1}")
if (_script_src STREQUAL "" OR _style_elem STREQUAL "")
    message(FATAL_ERROR "the policy has no script-src or style-src-elem directive")
endif ()

# --- the inline blocks of index.html ---
file(READ "${INDEX_HTML}" _html)
set(_problems 0)

if (_html MATCHES "[ \t\n]style=\"" OR _html MATCHES "[ \t\n]style='" OR _html MATCHES "[ \t\n]on[a-zA-Z]+=[\"']")
    message(SEND_ERROR "index.html has an inline style=\"...\" or on*=\"...\" attribute: this script cannot hash those statically; classify it by hand")
    math(EXPR _problems "${_problems}+1")
endif ()

set(_script_hashes "")
set(_style_hashes "")
foreach (_tag IN ITEMS script style)
    set(_rest "${_html}")
    while (TRUE)
        string(FIND "${_rest}" "<${_tag}" _open)
        if (_open EQUAL -1)
            break()
        endif ()
        string(SUBSTRING "${_rest}" ${_open} -1 _rest)
        string(FIND "${_rest}" ">" _gt)
        string(SUBSTRING "${_rest}" 0 ${_gt} _attrs)
        math(EXPR _body_start "${_gt}+1")
        string(SUBSTRING "${_rest}" ${_body_start} -1 _after)
        string(FIND "${_after}" "</${_tag}>" _close)
        if (_close EQUAL -1)
            message(FATAL_ERROR "unterminated <${_tag}> in index.html")
        endif ()
        string(SUBSTRING "${_after}" 0 ${_close} _body)
        math(EXPR _next "${_body_start}+${_close}")
        string(SUBSTRING "${_rest}" ${_next} -1 _rest)
        if (_attrs MATCHES "[ \t\n]src=")
            continue() # external, covered by 'self'
        endif ()
        string(SHA256 _hex "${_body}")
        hex_to_base64("${_hex}" _b64sum)
        message(STATUS "inline <${_tag}> (${_close} bytes): 'sha256-${_b64sum}'")
        list(APPEND _${_tag}_hashes "sha256-${_b64sum}")
    endwhile ()
endforeach ()

foreach (_h IN LISTS _script_hashes)
    string(FIND "${_script_src}" "'${_h}'" _p)
    if (_p EQUAL -1)
        message(SEND_ERROR "inline <script> hash missing from script-src: '${_h}'")
        math(EXPR _problems "${_problems}+1")
    endif ()
endforeach ()
foreach (_h IN LISTS _style_hashes)
    string(FIND "${_style_elem}" "'${_h}'" _p)
    if (_p EQUAL -1)
        message(SEND_ERROR "inline <style> hash missing from style-src-elem: '${_h}'")
        math(EXPR _problems "${_problems}+1")
    endif ()
endforeach ()
# script-src must not carry a hash that no inline script has (a stale hash only loosens the policy).
string(REGEX MATCHALL "'sha256-[A-Za-z0-9+/=]+'" _policy_script_hashes "${_script_src}")
foreach (_q IN LISTS _policy_script_hashes)
    string(REPLACE "'" "" _h "${_q}")
    list(FIND _script_hashes "${_h}" _idx)
    if (_idx EQUAL -1)
        message(SEND_ERROR "script-src has a hash no inline script in index.html produces: ${_q}")
        math(EXPR _problems "${_problems}+1")
    endif ()
endforeach ()

# What was not recomputed.
string(REGEX MATCHALL "'sha256-[A-Za-z0-9+/=]+'" _policy_style_hashes "${_style_elem}")
set(_dynamic 0)
foreach (_q IN LISTS _policy_style_hashes)
    string(REPLACE "'" "" _h "${_q}")
    list(FIND _style_hashes "${_h}" _idx)
    if (_idx EQUAL -1)
        math(EXPR _dynamic "${_dynamic}+1")
    endif ()
endforeach ()

if (_problems GREATER 0)
    message(FATAL_ERROR "${_problems} problem(s): the policy does not match the bundle's inline content")
endif ()
message(STATUS "OK: ${_script_hashes} / ${_style_hashes} are covered")
message(STATUS "NOTE: ${_dynamic} style-src-elem hash(es), style-src-attr and script-src-attr could NOT be recomputed here (runtime-created or parsed attribute content); they were verified in headless Chrome for bundle 2.3.40 only.")
message(STATUS "NOTE: a bundle bump needs the headless re-verification (docs/third-party/flutter_web.md, scripts/csp_report_only_check.py) before this policy is trusted.")
