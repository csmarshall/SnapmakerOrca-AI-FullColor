# Verifies the vendored, unmodified Snapmaker Flutter bundle against its SHA-256 manifest.
#   cmake -DBUNDLE_DIR=<resources/web/flutter_web> -DMANIFEST=<resources/web/flutter_web.sha256> -P verify_flutter_web.cmake
# Fails (non-zero exit) on any changed, missing or extra file, on an empty manifest and on an empty
# bundle directory. Manifest lines are "<sha256>  <path relative to BUNDLE_DIR>", as written by
# `shasum -a 256`. This is a test-time check (ctest), not a runtime tamper control.
# Paths containing [ ] or ; are handled for the manifest side; the extra-file scan uses file(GLOB_RECURSE),
# which splits on ';', so a ';' in a bundle file name is caught by the count comparison instead.
cmake_minimum_required(VERSION 3.13)

if (NOT BUNDLE_DIR OR NOT MANIFEST)
    message(FATAL_ERROR "usage: cmake -DBUNDLE_DIR=... -DMANIFEST=... -P verify_flutter_web.cmake")
endif ()
if (NOT EXISTS "${MANIFEST}")
    message(FATAL_ERROR "manifest not found: ${MANIFEST}")
endif ()
if (NOT IS_DIRECTORY "${BUNDLE_DIR}")
    message(FATAL_ERROR "bundle directory not found: ${BUNDLE_DIR}")
endif ()

# Read as one string and walk it by newline: file(STRINGS) and lists mangle '[', ']' and ';'.
file(READ "${MANIFEST}" _text)
string(LENGTH "${_text}" _len)
set(_problems 0)
set(_entries 0)
set(_pos 0)
while (_pos LESS _len)
    string(SUBSTRING "${_text}" ${_pos} -1 _rest)
    string(FIND "${_rest}" "\n" _nl)
    if (_nl EQUAL -1)
        set(_line "${_rest}")
        math(EXPR _pos "${_len}")
    else ()
        string(SUBSTRING "${_rest}" 0 ${_nl} _line)
        math(EXPR _pos "${_pos}+${_nl}+1")
    endif ()
    string(REGEX REPLACE "\r$" "" _line "${_line}")
    if (_line STREQUAL "")
        continue()
    endif ()
    if (NOT _line MATCHES "^([0-9a-f]+)  (.+)$")
        message(SEND_ERROR "malformed manifest line: ${_line}")
        math(EXPR _problems "${_problems}+1")
        continue()
    endif ()
    set(_hash "${CMAKE_MATCH_1}")
    set(_rel "${CMAKE_MATCH_2}")
    math(EXPR _entries "${_entries}+1")
    string(MD5 _key "${_rel}")
    set(_expected_${_key} 1)
    set(_file "${BUNDLE_DIR}/${_rel}")
    if (NOT EXISTS "${_file}")
        message(SEND_ERROR "missing: ${_rel}")
        math(EXPR _problems "${_problems}+1")
        continue()
    endif ()
    file(SHA256 "${_file}" _actual)
    if (NOT _actual STREQUAL _hash)
        message(SEND_ERROR "modified: ${_rel}")
        math(EXPR _problems "${_problems}+1")
    endif ()
endwhile ()

if (_entries EQUAL 0)
    message(FATAL_ERROR "manifest has no entries: ${MANIFEST}")
endif ()

file(GLOB_RECURSE _present RELATIVE "${BUNDLE_DIR}" LIST_DIRECTORIES false "${BUNDLE_DIR}/*")
list(LENGTH _present _n_present)
if (_n_present EQUAL 0)
    message(FATAL_ERROR "bundle directory has no files: ${BUNDLE_DIR}")
endif ()
foreach (_rel IN LISTS _present)
    string(MD5 _key "${_rel}")
    if (NOT DEFINED _expected_${_key})
        message(SEND_ERROR "extra file not in manifest: ${_rel}")
        math(EXPR _problems "${_problems}+1")
    endif ()
endforeach ()
if (NOT _n_present EQUAL _entries)
    message(SEND_ERROR "file count ${_n_present} differs from manifest entries ${_entries}")
    math(EXPR _problems "${_problems}+1")
endif ()

if (_problems GREATER 0)
    message(FATAL_ERROR "flutter_web bundle does not match ${MANIFEST} (${_problems} problem(s))")
endif ()
message(STATUS "flutter_web bundle OK: ${_entries} files match the manifest")
